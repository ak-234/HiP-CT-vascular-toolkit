# ── Generated output trees ───────────────────────────────────────────────────
# These are run products. They are what made the pre-monorepo history
# unpublishable (a single tracked log reached 2.98 GB), so they are excluded by
# directory name rather than only by extension.
logs/
cache/
runs/
models/
out/
output_*/
analysis_out/
benchmark_out/
benchmark_smoke/
benchmark_[0-9]*/
